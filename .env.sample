# ===========================================
# 可编排多工具销售任务拆解 Agent 配置文件
# ===========================================
#
# ============ Docker 部署说明 ============
# 1. 复制此文件为 .env: cp .env.sample .env
# 2. 根据实际环境修改配置
# 3. 启动服务: docker compose up -d
# 4. 访问服务: http://localhost:8000
#
# ============ 可选配置 ============
# - 启用 Redis 缓存: 设置 REDIS_ENABLED=true
# - 启用 LangFuse 监控: 设置 LANGFUSE_ENABLED=true，运行 docker compose --profile monitoring up -d
# - 使用真实 LLM: 设置 USE_MOCK_DATA=false，配置 OPENAI_API_KEY
# - 使用本地 Ollama: 设置 LLM_MODE=qwen，配置 OLLAMA_BASE_URL
# ===========================================

# ==================== 大模型配置 ====================
# 模式选择: openai | qwen
LLM_MODE=openai

# OpenAI 配置（云端模式）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
OPENAI_MODEL=glm-5.1

# Qwen/Ollama 配置（本地私有化模式）
# Docker 环境下，Ollama 通常运行在宿主机，使用 host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen:7b

# ==================== 数据库配置 ====================
# 数据库类型: sqlite | mysql | postgresql
DB_TYPE=sqlite

# SQLite 数据库路径（Docker 环境下使用 /app 前缀）
# 本地开发: ./storage/sqlite/sales_agent.db
# Docker 部署: /app/storage/sqlite/sales_agent.db
SQLITE_DB_PATH=./storage/sqlite/sales_agent.db

# Chroma 向量数据库路径
# 本地开发: ./storage/chroma_db
# Docker 部署: /app/storage/chroma_db
CHROMA_DB_PATH=./storage/chroma_db

# 文档库路径
DOCS_PATH=./docs

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
# 本地开发: ./logs/sales_agent.log
# Docker 部署: /app/logs/sales_agent.log
LOG_FILE=./logs/sales_agent.log

# ==================== 工具配置 ====================
# 工具超时配置（秒）
TOOL_TIMEOUT=30

# 反思验真配置
REFLECTION_ENABLED=true
REFLECTION_CONFIDENCE_THRESHOLD=0.8

# ==================== 模拟数据配置 ====================
# 开发测试时设为 true，生产环境设为 false
USE_MOCK_DATA=true

# ==================== Embedding 模型配置 ====================
# 本地 BGE embedding 模型路径
# 本地开发: ./models/bge-small-zh-v1.5
# Docker 部署: /app/models/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
USE_LOCAL_EMBEDDING=true

# ==================== Redis 缓存配置 ====================
# 启用 Redis 缓存（Docker 环境下推荐启用）
REDIS_ENABLED=false
# Docker 环境下 Redis 服务名为 redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 缓存过期时间（秒）
CACHE_TTL_INVENTORY=3600
CACHE_TTL_PRICING=7200
CACHE_TTL_CASES=86400

# ==================== Langfuse 监控配置 ====================
# 启用 LangFuse 监控（需要单独启动 langfuse 服务）
LANGFUSE_ENABLED=false
# Docker 环境下 Langfuse 服务名为 langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_TRACING_SAMPLE_RATE=1.0