# ===========================================
# 可编排多工具销售任务拆解 Agent 配置文件
# ===========================================

# 大模型配置（二选一）
# 模式选择: openai | qwen
LLM_MODE=openai

# OpenAI 配置（云端模式）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Qwen/Ollama 配置（本地私有化模式）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen:7b

# 数据库配置
# SQLite 数据库路径
SQLITE_DB_PATH=./storage/sqlite/sales_agent.db

# Chroma 向量数据库路径
CHROMA_DB_PATH=./storage/chroma_db

# 文档库路径
DOCS_PATH=./docs

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/sales_agent.log

# 工具超时配置（秒）
TOOL_TIMEOUT=30

# 反思验真配置
REFLECTION_ENABLED=true
REFLECTION_CONFIDENCE_THRESHOLD=0.8

# 模拟数据配置（个人项目使用）
USE_MOCK_DATA=true